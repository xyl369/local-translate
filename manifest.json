{
  "manifest_version": 3,
  "name": "Local Translate",
  "version": "3.10.2",
  "description": "Auditable bilingual translate + YouTube dual subs. Google translate-pa batch; optional Chrome on-device. No analytics, no local LLM.",
  "permissions": ["storage", "activeTab", "scripting", "contextMenus", "offscreen", "tabs"],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://translate-pa.googleapis.com/*",
    "https://clients5.google.com/*",
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Local Translate",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "toggle-translate": {
      "suggested_key": {
        "default": "Alt+A",
        "mac": "Alt+A"
      },
      "description": "Translate / restore current page"
    }
  }
}
